# Ignore everything at the repo root by default
/*

# Keep project config tracked
!/.gitignore
!/.cpanel.yml
!/docker-compose.yml

# Allow traversing into wp-content, but ignore its contents
!/wp-content/
/wp-content/*

# Allow traversing into themes, but ignore other themes
!/wp-content/themes/
/wp-content/themes/*

# Track only the custom theme
!/wp-content/themes/abilityworks21/
!/wp-content/themes/abilityworks21/**

# Build/tooling artifacts inside the theme
/wp-content/themes/abilityworks21/node_modules/

# macOS (after whitelist so these stay ignored)
.DS_Store
**/.DS_Store
